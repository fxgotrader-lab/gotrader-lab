TWELVE_DATA_API_KEY=
FMP_API_KEY=
GOTRADER_MODE=paper

# Optional local LLM advisory tuning.
# Health/status checks stay fast in code; this only controls advisory requests.
LLM_ADVISORY_TIMEOUT_MS=20000

# Optional local tuning for Twelve Data scripts.
TWELVE_DATA_TIMEOUT_MS=10000
TWELVE_DATA_CACHE_TTL_MS=30000
TWELVE_DATA_MIN_REQUEST_INTERVAL_MS=850

# Optional local tuning for FMP market-context scripts.
FMP_TIMEOUT_MS=10000
FMP_MIN_REQUEST_INTERVAL_MS=1000
FMP_ECONOMIC_CACHE_TTL_MS=21600000
FMP_NEWS_CACHE_TTL_MS=600000
FMP_SYMBOL_NEWS_CACHE_TTL_MS=1200000
